{
    "name": "hankchen/php-canvas",
    "description": "this is a library for draw image like ps which use layer compose",
    "type": "library",
    "autoload": {
        "psr-4": {
            "HankChen\\Canvas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HankChen\\Canvas\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-clover=coverage.xml --coverage-text",
        "check-coverage": "@php scripts/check-coverage.php"
    },
    "authors": [
        {
            "name": "HankChen"
        }
    ],
    "require": {
        "php": "^8.3",
        "endroid/qr-code": "^6.0",
        "intervention/image": "^4.0"
    },
    "suggest": {},
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
}
